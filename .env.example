# =============================================================================
# Copy to `.env` to customise local Docker or deployment settings:
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL Owner (used by database/migrate.sh) --------------------------
POSTGRES_USER=chn_owner
POSTGRES_PASSWORD=chn_owner_dev_pw
POSTGRES_DB=chn_events
POSTGRES_PORT=5432

# --- Least-Privilege Application Users ---------------------------------------
# Created automatically by database/migrate.sh -> create_app_users.sql
SCRAPER_DB_USER=chn_scraper
SCRAPER_DB_PASSWORD=chn_scraper_dev_pw
API_DB_USER=chn_api
API_DB_PASSWORD=chn_api_dev_pw

# --- Read API Gateway --------------------------------------------------------
API_PORT=8080
CORS_ALLOW_ORIGIN=*

# --- Scraper / Parser Daemon -------------------------------------------------
SCRAPER_USER_AGENT="CampusHeilbronnEventsBot/0.1 (+https://github.com/your-org/CampusHeilbronnNewsParcer; contact: your-email@tum.de)"
SCRAPER_REQUEST_DELAY_SECONDS=1.5
SCRAPER_REQUEST_TIMEOUT_SECONDS=20.0
SCRAPER_MAX_RETRIES=3
SCRAPER_RESPECT_ROBOTS_TXT=true
# Comma-separated parser keys to run; leave empty to run all registered parsers
SCRAPER_ENABLED_PARSERS=
SCRAPER_DAEMON_TICK_SECONDS=60
LOG_LEVEL=INFO

# --- Google Firebase / Cloud Run Deployment (optional) -----------------------
GCP_PROJECT_ID=tum-chn-events-proto
GCP_REGION=europe-west3

